# 复制为 .env；不要提交 .env、真实证书或任何支付密钥。
# 完整步骤见 docs/07-生产部署与支付宝.md。根目录 .env 供 Docker Compose 插值使用。

APP_VERSION=ruomu-local
APP_TOTP_ISSUER=若木云卡

# 三个互不相同的域名，不带协议、路径或端口。需解析到部署服务器。
USER_DOMAIN=shop.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
# 默认仅网关对外监听 80/443；内部 API、前端、Redis 无宿主机端口。
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
# 绝对路径；目录下每个域名各放 fullchain.pem、privkey.pem。
TLS_CERT_DIR=/etc/ruomu/tls

# 每项独立执行 openssl rand -hex 32 生成；生产启动后勿随意更换 APP_SECRET_KEY。
APP_SECRET_KEY=
JWT_SECRET=
USER_JWT_SECRET=
REDIS_PASSWORD=

# 仅首次初始化空数据库时生效；用户名不可为空，密码至少 16 位含大小写及数字。
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
JWT_EXPIRE_HOURS=24

# 部署校验期望值：必须与管理后台「官方 / 支付宝」渠道中的字段一致。
# 这些变量不会自动创建渠道、写入数据库或配置支付宝平台。
# 默认回调路由；管理后台「回调路由」中支付回调自定义项应留空。
ALIPAY_NOTIFY_URL=https://api.example.com/api/v1/payments/callback
ALIPAY_RETURN_URL=https://shop.example.com/pay
# 不在环境文件存放支付宝私钥。在管理后台配置 app_id/private_key/alipay_public_key 等。

# 默认 SQLite 使用持久卷；外部 PostgreSQL 使用 postgres + 对应 DSN。
DATABASE_DRIVER=sqlite
DATABASE_DSN=/app/db/ruomu.db
REDIS_PREFIX=ruomu
EMAIL_ENABLED=false
CAPTCHA_PROVIDER=none

# 三端默认走同域 /api/v1。根目录 VITE_* 不会注入构建；无需设置。
# 旧草案 API_BASE_URL / PUBLIC_SITE_URL / ADMIN_SITE_URL / PAYMENT_CALLBACK_URL、
# DATABASE_URL / REDIS_URL / UPLOAD_PATH 未被生产 compose 消费，已移除。
